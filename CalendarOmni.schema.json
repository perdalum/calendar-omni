{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CalendarOmni successful output, version 1",
  "description": "Output contract for extract, create and update: six content fields plus opt-in calculated duration for extraction and fixed _ref metadata. Errors use stderr and nonzero exit codes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "command",
    "timeZone",
    "fields",
    "events"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "command": {
      "enum": [
        "extract",
        "create",
        "update"
      ]
    },
    "timeZone": {
      "type": "string",
      "minLength": 1,
      "description": "Resolved IANA zone for input interpretation and timed output rendering; validate identifier in application code."
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "enum": [
          "title",
          "start",
          "end",
          "location",
          "attendees",
          "notes",
          "duration"
        ]
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    }
  },
  "$defs": {
    "event": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "start": {
          "oneOf": [
            {
              "type": "string",
              "format": "date",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
            }
          ]
        },
        "end": {
          "oneOf": [
            {
              "type": "string",
              "format": "date",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
            }
          ]
        },
        "location": {
          "type": [
            "string",
            "null"
          ]
        },
        "attendees": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/attendee"
          }
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "_ref": {
          "$ref": "#/$defs/eventRef"
        },
        "duration": {
          "type": "number",
          "description": "Elapsed (end - start) in minutes, without units. Fractional minutes are preserved. All-day dates use midnight in the output timeZone; DST days may differ from 1440 minutes."
        }
      },
      "required": [
        "_ref"
      ]
    },
    "attendee": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "url"
      ],
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "EventKit participant URL, usually mailto:, retained without assuming it is an email address."
        }
      }
    },
    "eventRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventId",
        "calendarId",
        "isRecurring",
        "occurrenceDate"
      ],
      "properties": {
        "eventId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "calendarId": {
          "type": "string",
          "minLength": 1
        },
        "isRecurring": {
          "type": "boolean"
        },
        "occurrenceDate": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "isRecurring": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "occurrenceDate": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "fields": {
            "contains": {
              "const": "title"
            }
          }
        }
      },
      "then": {
        "properties": {
          "events": {
            "items": {
              "required": [
                "title"
              ]
            }
          }
        }
      },
      "else": {
        "properties": {
          "events": {
            "items": {
              "not": {
                "required": [
                  "title"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "fields": {
            "contains": {
              "const": "start"
            }
          }
        }
      },
      "then": {
        "properties": {
          "events": {
            "items": {
              "required": [
                "start"
              ]
            }
          }
        }
      },
      "else": {
        "properties": {
          "events": {
            "items": {
              "not": {
                "required": [
                  "start"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "fields": {
            "contains": {
              "const": "end"
            }
          }
        }
      },
      "then": {
        "properties": {
          "events": {
            "items": {
              "required": [
                "end"
              ]
            }
          }
        }
      },
      "else": {
        "properties": {
          "events": {
            "items": {
              "not": {
                "required": [
                  "end"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "fields": {
            "contains": {
              "const": "location"
            }
          }
        }
      },
      "then": {
        "properties": {
          "events": {
            "items": {
              "required": [
                "location"
              ]
            }
          }
        }
      },
      "else": {
        "properties": {
          "events": {
            "items": {
              "not": {
                "required": [
                  "location"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "fields": {
            "contains": {
              "const": "attendees"
            }
          }
        }
      },
      "then": {
        "properties": {
          "events": {
            "items": {
              "required": [
                "attendees"
              ]
            }
          }
        }
      },
      "else": {
        "properties": {
          "events": {
            "items": {
              "not": {
                "required": [
                  "attendees"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "fields": {
            "contains": {
              "const": "notes"
            }
          }
        }
      },
      "then": {
        "properties": {
          "events": {
            "items": {
              "required": [
                "notes"
              ]
            }
          }
        }
      },
      "else": {
        "properties": {
          "events": {
            "items": {
              "not": {
                "required": [
                  "notes"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "create"
          }
        }
      },
      "then": {
        "properties": {
          "fields": {
            "const": [
              "title",
              "start",
              "end",
              "location",
              "attendees",
              "notes"
            ]
          },
          "events": {
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "properties": {
                "title": {
                  "pattern": "\\S"
                },
                "start": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
                },
                "end": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "enum": [
              "create",
              "update"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "fields": {
            "const": [
              "title",
              "start",
              "end",
              "location",
              "attendees",
              "notes"
            ]
          },
          "events": {
            "items": {
              "properties": {
                "_ref": {
                  "properties": {
                    "isRecurring": {
                      "const": false
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "fields": {
            "contains": {
              "const": "duration"
            }
          }
        }
      },
      "then": {
        "properties": {
          "events": {
            "items": {
              "required": [
                "duration"
              ]
            }
          }
        }
      },
      "else": {
        "properties": {
          "events": {
            "items": {
              "not": {
                "required": [
                  "duration"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
